DATABASE_URL=postgresql://delta:CHANGE_ME@127.0.0.1:55432/delta
AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false
DEV_SMS=true
SMS_ENDPOINT=
SMS_TOKEN=
DEV_FIXED_OTP_ENABLED=false

# Optional, explicit single-account production exception (maximum 24 hours).
# Keep disabled unless the owner authorizes temporary access. Sessions expire with it.
TEMP_LOGIN_ENABLED=false
TEMP_LOGIN_PHONE=
TEMP_LOGIN_STARTS_AT=
TEMP_LOGIN_EXPIRES_AT=
MEMBERS_ONLY_LOGIN=false

# mock is accepted only with NODE_ENV=development; live gateway is unconfigured.
PAYMENT_PROVIDER=unconfigured

# Notification SMS has no production adapter until a documented provider is configured.
NOTIFICATION_SMS_PROVIDER=unconfigured
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional server-only fallback; normally configure the encrypted key in management settings.
FARAZSMS_API_KEY=
